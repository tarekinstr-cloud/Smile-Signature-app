# ═══════════════════════════════════════════════════════════════════════════════════════════════
# Réglages du serveur local Smile Signature.
# Ce fichier est copié en « .env » par 1-INSTALLER.bat, qui remplace chaque A_GENERER par un secret
# aléatoire. Ne partagez jamais le fichier .env : il contient les mots de passe de la base.
# ═══════════════════════════════════════════════════════════════════════════════════════════════

# Secrets (générés à l'installation, à ne pas modifier ensuite : la base et les comptes en dépendent).
POSTGRES_PASSWORD=A_GENERER
JWT_SECRET=A_GENERER
ANON_KEY=A_GENERER
SERVICE_ROLE_KEY=A_GENERER
SECRET_KEY_BASE=A_GENERER
PG_META_CRYPTO_KEY=A_GENERER

# Durée d'une session (secondes) : 7 jours. L'app renouvelle la session toute seule.
JWT_EXPIRY=604800

# Adresse du POS vue par les autres appareils (facultatif, sert aux liens générés par le serveur).
SITE_URL=http://localhost

# Port du serveur web : 80 = http://localhost et http://IP-du-POS sans numéro de port.
# Si le port 80 est déjà pris sur le PC (IIS, Skype…), mettre 8080 et ouvrir http://localhost:8080.
HTTP_PORT=80

# ── Basculer l'application entre le serveur local et le Supabase en ligne ──
# Vide (par défaut) : l'application utilise ce serveur local.
# Pour utiliser le Supabase en ligne : URL du projet et clé « anon public » (Project Settings > API),
# puis double-cliquer METTRE-A-JOUR.bat.
APP_SUPABASE_URL=
APP_SUPABASE_ANON_KEY=
